# ==============================================================================
# CodeTrack — Production Environment Configuration
# ==============================================================================

# Application Base URL (e.g. http://localhost:3000 in dev, https://your-domain.vercel.app in prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reporting Timezone (Mandatory: Asia/Kolkata UTC+05:30)
REPORTING_TIMEZONE=Asia/Kolkata

# ==============================================================================
# Supabase Cloud PostgreSQL & Supabase Auth Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Shared secret to authenticate dedicated background scraper workers
SCRAPER_WORKER_SECRET=your-random-long-secret-key
